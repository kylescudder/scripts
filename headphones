#!/bin/bash

# Switch to analog headphones and move all audio there

set -euo pipefail

CARD_NAME="alsa_card.pci-0000_00_1f.3"
SINK_NAME="alsa_output.pci-0000_00_1f.3.analog-stereo"
CHANGE_AUDIO_SCRIPT="$HOME/Documents/Repos/scripts/change_audio"

echo "Switching ${CARD_NAME} to profile 'output:analog-stereo'..."
pactl set-card-profile "${CARD_NAME}" output:analog-stereo

# Give Pulse a brief moment if needed
sleep 0.1

echo "Routing all audio to sink '${SINK_NAME}'..."
"${CHANGE_AUDIO_SCRIPT}" "${SINK_NAME}"
