#!/usr/bin/env bash

set -euo pipefail

# This script is designed to be safely rerunnable. Package database refreshes,
# available package upgrades, log entries, and completion notifications are
# intentional on every run; configuration and third-party installers converge.

# -----------------------------------------------------------------------------
# Configuration
# -----------------------------------------------------------------------------

EMAIL="kyle@kylescudder.co.uk"
LOG_FILE="/var/log/system_setup.log"

REPO_DIR="$HOME/Documents/Repos"

DOTFILES_REPO="https://github.com/kylescudder/dotfiles.git"
SCRIPTS_REPO="https://github.com/kylescudder/scripts.git"
HERDR_REPO="https://github.com/kylescudder/herdr"

INSTALL_USER="$(id -un)"
INSTALL_GROUP="$(id -gn)"
SUDO_KEEPALIVE_PID=""

# -----------------------------------------------------------------------------
# Bootstrap
# -----------------------------------------------------------------------------

stop_sudo_keepalive() {
    if [[ -z "$SUDO_KEEPALIVE_PID" ]]; then
        return
    fi

    if kill -0 "$SUDO_KEEPALIVE_PID" 2>/dev/null; then
        kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true
        wait "$SUDO_KEEPALIVE_PID" 2>/dev/null || true
    fi
}

start_sudo_keepalive() {
    # Long AUR builds can outlive sudo's credential timeout. Refresh only the
    # timestamp established by the interactive preflight; never prompt here.
    (
        while true; do
            sleep 50
            sudo -n -v >/dev/null 2>&1 || exit
        done
    ) &

    SUDO_KEEPALIVE_PID=$!
    trap stop_sudo_keepalive EXIT
}

check_environment() {
    # makepkg must not run as root.
    if [[ $EUID -eq 0 ]]; then
        echo "ERROR: Do not run this script as root."
        echo
        echo "Run it as your normal user:"
        echo
        echo "    bash install.sh"
        echo
        echo "The script will use sudo only where root access is required."
        exit 1
    fi

    if ! command -v sudo >/dev/null 2>&1; then
        echo "ERROR: sudo is not installed."
        exit 1
    fi

    echo "Checking sudo access..."
    sudo -v

    if [[ "$(sudo id -u)" -ne 0 ]]; then
        echo "ERROR: $INSTALL_USER does not have working sudo access."
        exit 1
    fi

    start_sudo_keepalive
}

init_logging() {
    sudo touch "$LOG_FILE"
    sudo chown "$INSTALL_USER:$INSTALL_GROUP" "$LOG_FILE"
    sudo chmod 0644 "$LOG_FILE"
}

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

log() {
    local message="$1"
    local timestamp

    timestamp="$(date '+%Y-%m-%d %H:%M:%S')"

    echo "[$timestamp] $message" | tee -a "$LOG_FILE"
}

error() {
    local message="$1"

    # Avoid recursively triggering ERR while handling an error.
    trap - ERR

    log "ERROR: $message"

    send_email \
        "Script Error" \
        "An error occurred during system setup: $message"

    exit 1
}

send_email() {
    local subject="$1"
    local body="$2"

    if command -v mail >/dev/null 2>&1; then
        echo "$body" | mail -s "$subject" "$EMAIL" || true
    else
        log "Warning: mail command not found. Could not send email notification."
    fi
}

# -----------------------------------------------------------------------------
# System
# -----------------------------------------------------------------------------

update_system() {
    log "Updating system packages..."

    sudo pacman -Syu --noconfirm \
        || error "System update failed"

    log "System update completed successfully"
}

install_build_dependencies() {
    log "Installing build dependencies..."

    sudo pacman -S --needed --noconfirm \
        git \
        base-devel \
        curl \
        unzip \
        || error "Build dependencies installation failed"

    log "Build dependencies installation completed"
}

install_tailscale() {
    if command -v tailscale >/dev/null 2>&1; then
        log "Tailscale is already installed"
        return
    fi

    log "Installing Tailscale..."

    curl -fsSL https://tailscale.com/install.sh | sh \
        || error "Tailscale installation failed"

    log "Tailscale installation completed"
}

# -----------------------------------------------------------------------------
# Paru
# -----------------------------------------------------------------------------

install_paru() {
    if command -v paru >/dev/null 2>&1; then
        log "paru is already installed"
        return
    fi

    log "Installing paru AUR helper..."

    local build_dir
    build_dir="$(mktemp -d)"

    git clone https://aur.archlinux.org/paru.git "$build_dir/paru" \
        || error "Failed to clone paru repository"

    cd "$build_dir/paru"

    # IMPORTANT: deliberately NOT sudo.
    makepkg -si --noconfirm \
        || error "Failed to install paru"

    cd "$HOME"
    rm -rf "$build_dir"

    log "paru installation completed"
}

# -----------------------------------------------------------------------------
# Desktop environment
# -----------------------------------------------------------------------------

install_desktop_environment() {
    log "Installing desktop environment components..."

    sudo pacman -S --needed --noconfirm gnome \
        || error "GNOME installation failed"

    sudo pacman -S --needed --noconfirm \
        hyprland \
        hyprland-guiutils \
        || error "Hyprland installation failed"

    log "Desktop environment installation completed"
}

# -----------------------------------------------------------------------------
# Development tools
# -----------------------------------------------------------------------------

install_dev_tools() {
    log "Installing development tools..."

    if [[ "$(git config --global --get user.name || true)" != "Kyle Scudder" ]]; then
        git config --global user.name "Kyle Scudder"
    fi

    if [[ "$(git config --global --get user.email || true)" != "$EMAIL" ]]; then
        git config --global user.email "$EMAIL"
    fi

    sudo pacman -S --needed --noconfirm \
        nodejs \
        npm \
        dotnet-runtime \
        dotnet-sdk \
        aspnet-runtime \
        neovim \
        lazygit \
        python \
        python-pip \
        fzf \
        || error "Development tools installation failed"

    log "Development tools installation completed"
}

# -----------------------------------------------------------------------------
# Herdr
# -----------------------------------------------------------------------------

install_herdr() {
    if command -v herdr >/dev/null 2>&1; then
        log "Herdr is already installed"
        return
    fi

    log "Installing Herdr from $HERDR_REPO..."

    local architecture
    local release_asset
    local download_dir

    architecture="$(uname -m)"

    case "$architecture" in
        x86_64)
            release_asset="herdr-linux-x86_64"
            ;;
        aarch64|arm64)
            release_asset="herdr-linux-aarch64"
            ;;
        *)
            error "Herdr does not provide a Linux release for $architecture"
            ;;
    esac

    download_dir="$(mktemp -d)" \
        || error "Failed to create Herdr download directory"

    curl -fL \
        "$HERDR_REPO/releases/latest/download/$release_asset" \
        -o "$download_dir/herdr" \
        || error "Failed to download Herdr"

    sudo install \
        -Dm755 \
        "$download_dir/herdr" \
        /usr/local/bin/herdr \
        || error "Failed to install Herdr"

    rm -rf "$download_dir"

    log "Herdr installation completed"
}

# -----------------------------------------------------------------------------
# Terminal
# -----------------------------------------------------------------------------

setup_terminal() {
    log "Setting up terminal environment..."

    paru -S --needed --noconfirm ghostty-git \
        || error "Ghostty installation failed"

    sudo pacman -S --needed --noconfirm zsh starship \
        || error "Shell tools installation failed"

    local current_shell
    current_shell="$(getent passwd "$INSTALL_USER" | cut -d: -f7)" \
        || error "Failed to determine the current login shell"

    if [[ "$current_shell" != /usr/bin/zsh ]]; then
        sudo chsh -s /usr/bin/zsh "$INSTALL_USER" \
            || error "Failed to set ZSH as default shell"
    else
        log "ZSH is already the default shell"
    fi

    install_herdr

    if command -v bun >/dev/null 2>&1 || [[ -x "$HOME/.bun/bin/bun" ]]; then
        log "Bun is already installed"
    else
        log "Installing Bun..."

        curl -fsSL https://bun.sh/install | bash \
            || error "Bun installation failed"
    fi

    log "Terminal setup completed"
}

# -----------------------------------------------------------------------------
# GRUB
# -----------------------------------------------------------------------------

setup_grub_theme() {
    log "Setting up Catppuccin GRUB theme..."

    local grub_dir=""
    local grub_theme_file="/usr/share/grub/themes/catppuccin-mocha-grub-theme/theme.txt"
    local grub_theme_setting="GRUB_THEME=\"$grub_theme_file\""
    local grub_configuration_changed=false

    if [[ ! -f "$grub_theme_file" ]]; then
        grub_dir="$(mktemp -d)"

        git clone \
            https://github.com/catppuccin/grub.git \
            "$grub_dir/grub" \
            || error "Failed to clone GRUB theme"

        sudo cp -r \
            "$grub_dir/grub/src/"* \
            /usr/share/grub/themes/ \
            || error "Failed to copy GRUB themes"

        grub_configuration_changed=true
        rm -rf "$grub_dir"
    else
        log "Catppuccin GRUB theme is already installed"
    fi

    if ! grep -Fxq "$grub_theme_setting" /etc/default/grub; then
        if grep -q '^GRUB_THEME=' /etc/default/grub; then
            sudo sed -i \
                "s|^GRUB_THEME=.*|$grub_theme_setting|" \
                /etc/default/grub
        else
            echo "$grub_theme_setting" \
                | sudo tee -a /etc/default/grub >/dev/null
        fi

        grub_configuration_changed=true
    else
        log "Catppuccin is already configured as the GRUB theme"
    fi

    if [[ "$grub_configuration_changed" == true ]]; then
        sudo grub-mkconfig -o /boot/grub/grub.cfg \
            || error "Failed to update GRUB configuration"
    else
        log "GRUB configuration is already current"
    fi

    log "GRUB theme setup completed"
}

# -----------------------------------------------------------------------------
# Cura
# -----------------------------------------------------------------------------

install_cura() {
    log "Installing Cura..."

    sudo pacman -S --needed --noconfirm fuse \
        || error "FUSE installation failed"

    local appimage_dir="$HOME/.local/share/AppImages"

    mkdir -p "$appimage_dir" \
        || error "Failed to create AppImage directory"

    local appimage_path="$appimage_dir/Cura.AppImage"

    if [[ ! -f "$appimage_path" ]]; then
        curl -fL \
            "https://github.com/Ultimaker/Cura/releases/download/5.9.0/UltiMaker-Cura-5.9.0-linux-X64.AppImage" \
            -o "$appimage_path" \
            || error "Failed to download Cura"
    else
        log "Cura is already downloaded"
    fi

    if [[ ! -x "$appimage_path" ]]; then
        chmod +x "$appimage_path" \
            || error "Failed to make Cura executable"
    fi

    log "Cura installation completed"
}

# -----------------------------------------------------------------------------
# xone
# -----------------------------------------------------------------------------

install_xone() {
    log "Installing xone for Xbox controller firmware/drivers..."

    sudo pacman -S --needed --noconfirm \
        dkms \
        cabextract \
        linux-headers \
        || error "xone dependencies installation failed"

    local driver_installed=false
    local firmware_installed=false
    local xone_dir=""

    if sudo dkms status xone 2>/dev/null | grep -q .; then
        driver_installed=true
        log "xone driver is already installed"
    fi

    if [[ -f /lib/firmware/xow_dongle.bin ]]; then
        firmware_installed=true
        log "xone firmware is already installed"
    fi

    if [[ "$driver_installed" == true && "$firmware_installed" == true ]]; then
        log "xone installation is already complete"
        return
    fi

    if [[ "$driver_installed" == false ]] \
        || { [[ "$firmware_installed" == false ]] \
            && ! command -v xone-get-firmware.sh >/dev/null 2>&1; }; then
        xone_dir="$(mktemp -d)"

        git clone \
            https://github.com/medusalix/xone \
            "$xone_dir/xone" \
            || error "Failed to clone xone"
    fi

    if [[ "$driver_installed" == false ]]; then
        cd "$xone_dir/xone"

        sudo ./install.sh \
            || error "xone installation failed"

        cd "$HOME"
    fi

    if [[ "$firmware_installed" == false ]]; then
        if command -v xone-get-firmware.sh >/dev/null 2>&1; then
            sudo xone-get-firmware.sh --skip-disclaimer \
                || error "xone firmware installation failed"
        else
            sudo sh "$xone_dir/xone/install/firmware.sh" --skip-disclaimer \
                || error "xone firmware installation failed"
        fi
    fi

    if [[ -n "$xone_dir" ]]; then
        rm -rf "$xone_dir"
    fi

    log "xone installation completed"
}

# -----------------------------------------------------------------------------
# Applications
# -----------------------------------------------------------------------------

install_applications() {
    log "Installing applications..."

    paru -S --needed --noconfirm \
        stow \
        fastfetch \
        picom \
        feh \
        hyprshot \
        nvidia-open \
        linux-headers \
        yazi \
        btop \
        wlogout \
        || error "System utilities installation failed"

    sudo pacman -S --needed --noconfirm wget \
        || error "System utilities pacman installation failed"

    sudo pacman -S --needed --noconfirm \
        vlc \
        obsidian \
        thunderbird \
        || error "Desktop applications installation failed"

    paru -S --needed --noconfirm \
        rofi-wayland \
        waybar \
        swaync \
        hyprlock \
        hypridle \
        hyprpaper \
        || error "Wayland tools installation failed"

    sudo pacman -S --needed --noconfirm \
        ttf-font-awesome \
        || error "Font Awesome installation failed"

    paru -S --needed --noconfirm \
        ttf-meslo-nerd \
        || error "Nerd fonts installation failed"

    paru -S --needed --noconfirm \
        spotifyd \
        spotify-launcher \
        spicetify-cli \
        pavucontrol \
        || error "Music applications installation failed"

    log "Installing Helium browser..."

    paru -S --needed --noconfirm helium-browser-bin \
        || error "Helium browser installation failed"

    log "Installing SwayNC Catppuccin theme..."

    local swaync_dir="$HOME/.config/swaync"
    local swaync_theme="$swaync_dir/style.css"

    mkdir -p "$swaync_dir"

    if [[ ! -f "$swaync_theme" ]]; then
        curl -fL \
            "https://github.com/catppuccin/swaync/releases/latest/download/mocha.css" \
            -o "$swaync_theme" \
            || error "Failed to install SwayNC theme"
    else
        log "SwayNC Catppuccin theme is already installed"
    fi

    log "Applications installation completed"
}

# -----------------------------------------------------------------------------
# 1Password
# -----------------------------------------------------------------------------

install_1password() {
    log "Installing 1Password..."

    sudo pacman -S --needed --noconfirm \
        go \
        go-tools \
        xfsprogs \
        apparmor \
        squashfs-tools \
        gnupg \
        || error "1Password dependencies installation failed"

    if pacman -Q 1password >/dev/null 2>&1; then
        log "1Password is already installed"
    else
        curl -fsSL \
            https://downloads.1password.com/linux/keys/1password.asc \
            | gpg --import \
            || error "Failed to import 1Password signing key"

        paru -S --needed --noconfirm 1password \
            || error "1Password installation failed"
    fi

    log "1Password installation completed"
}

# -----------------------------------------------------------------------------
# Dotfiles
# -----------------------------------------------------------------------------

remove_stow_conflict() {
    local target="$1"
    local source="$2"

    if [[ ! -e "$target" && ! -L "$target" ]]; then
        return
    fi

    if [[ -L "$target" ]] \
        && [[ "$(readlink -f "$target")" == "$(readlink -f "$source")" ]]; then
        return
    fi

    rm -f "$target" \
        || error "Failed to remove conflicting file at $target"
}

setup_dotfiles() {
    log "Setting up dotfiles..."

    mkdir -p "$REPO_DIR"

    if [[ ! -d "$REPO_DIR/dotfiles/.git" ]]; then
        git clone "$DOTFILES_REPO" "$REPO_DIR/dotfiles" \
            || error "Dotfiles clone failed"
    else
        log "Dotfiles repository already exists"
    fi

    cd "$REPO_DIR/dotfiles"

    remove_stow_conflict \
        "$HOME/.config/hypr/hyprland.conf" \
        "$REPO_DIR/dotfiles/hyprland/.config/hypr/hyprland.conf"

    remove_stow_conflict \
        "$HOME/.bashrc" \
        "$REPO_DIR/dotfiles/bashrc/.bashrc"

    local stow_targets=(
        "hyprland"
        "waybar"
        "nvim"
        "spotifyd"
        "starship"
        "bashrc"
        "zsh"
        "applications"
        "icons"
        "wallpapers"
        "fastfetch"
        "rofi"
        "yazi"
        "ghostty"
        "btop"
        "wlogout"
    )

    for target in "${stow_targets[@]}"; do
        stow "$target" -t "$HOME" \
            || error "Failed to stow $target"
    done

    stow applications -t "$HOME/.local/share/" \
        || error "Failed to stow applications"

    stow icons -t "$HOME/.local/share/" \
        || error "Failed to stow icons"

    stow wallpapers -t "$HOME/.local/share/" \
        || error "Failed to stow wallpapers"

    sudo stow pixmaps -t "/usr/share/" \
        || error "Failed to stow pixmaps"

    log "Setting up scripts..."

    if [[ ! -d "$REPO_DIR/scripts/.git" ]]; then
        git clone "$SCRIPTS_REPO" "$REPO_DIR/scripts" \
            || error "Scripts clone failed"
    else
        log "Scripts repository already exists"
    fi

    if [[ ! -x "$REPO_DIR/scripts/songdetail" ]]; then
        chmod +x "$REPO_DIR/scripts/songdetail" \
            || error "Failed to make songdetail executable"
    fi

    log "Scripts setup completed"
    log "Dotfiles setup completed"
}

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------

main() {
    check_environment

    # MUST happen before the first call to log().
    init_logging

    trap 'error "An error occurred on line $LINENO. Check the logs for details."' ERR

    log "Starting system setup as $INSTALL_USER..."

    update_system
    install_build_dependencies
    install_tailscale
    install_paru
    install_desktop_environment
    install_dev_tools
    setup_terminal
    install_applications
    install_1password
    setup_dotfiles
    install_cura
    setup_grub_theme
    install_xone

    if sudo systemctl is-enabled --quiet gdm.service; then
        log "GDM is already enabled"
    else
        sudo systemctl enable gdm.service \
            || error "Failed to enable GDM"
    fi

    log "System setup completed successfully"

    send_email \
        "System Setup Complete" \
        "The system setup script has completed successfully. Check $LOG_FILE for details."
}

if [[ -z "${BASH_SOURCE[0]-}" || "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
